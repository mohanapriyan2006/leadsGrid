APP_NAME=LeadsGrid Agent Microservice
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173

REQUEST_TIMEOUT_SECONDS=15
SOURCE_LIMIT_DEFAULT=20

GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
