APP_ENV=development
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
DATABASE_URL=sqlite:///./pitchpilot.db
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5173"]
GEMINI_API_KEY=here-is-a-placeholder-for-your-gemini-api-key
GROQ_API_KEY=here-is-a-placeholder-for-your-groq-api-key
OPENROUTER_API_KEY=here-is-a-placeholder-for-your-openrouter-api-key

# Outbound email (SMTP)
EMAIL_FROM=PitchPilot <no-reply@pitchpilot.local>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_USE_SSL=true