SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_RATE_LIMIT_PER_MIN=20
SMTP_TIMEOUT_SECONDS=15

GITHUB_API_TOKEN=YOUR_KEY
SERPER_API_KEY=YOUR_SERPER_KEY
STACKEXCHANGE_API_KEY=YOUR_KEY
PRODUCTHUNT_API_TOKEN=YOUR_KEY

DEVTO_API_KEY=YOUR_KEY
GDELT_API_KEY=YOUR_KEY
REDDIT_CLIENT_ID=YOUR_KEY
REDDIT_CLIENT_SECRET=YOUR_KEY